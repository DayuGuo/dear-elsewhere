[Unit]
Description=Dear Elsewhere public index
After=network.target

[Service]
User=dear-elsewhere
Group=dear-elsewhere
WorkingDirectory=/opt/dear-elsewhere
StateDirectory=dear-elsewhere
EnvironmentFile=/etc/dear-elsewhere.env
UnsetEnvironment=X_BEARER_TOKEN
ExecStartPre=/opt/dear-elsewhere/.venv/bin/python -m elsewhere init
ExecStart=/opt/dear-elsewhere/.venv/bin/gunicorn --no-control-socket --bind 127.0.0.1:8791 --workers 1 --threads 2 elsewhere.web:app
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
